{
  "name": "regurolog",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "flowbite-react@0.12.17": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "devDependencies": {
    "jsdom": "29.0.1"
  },
  "scripts": {
    "build": "npm run build --workspace @regurolog/web",
    "check": "npm run typecheck --workspace @regurolog/web && npm run test:run --workspace @regurolog/web && npm run build --workspace @regurolog/web",
    "dev": "npm run dev --workspace @regurolog/web",
    "start": "npm run start --workspace @regurolog/web",
    "test": "npm run test --workspace @regurolog/web"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.8 <11"
  }
}
