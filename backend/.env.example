ENV=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/regurolog

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DEV_USERNAME=dev
# Generate with: uv run python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
DEV_PASSWORD_HASH=

BOT_INTERNAL_SECRET=change-me
BOT_USERNAME=
# Bot token can also be set later from the admin panel (Sozlamalar); this is the dev/bootstrap fallback.
BOT_TOKEN=
STAFF_SESSION_TTL_MINUTES=15

API_BASE_URL=http://localhost:8000
WEBAPP_URL=
# Telegram chat id the bot re-uploads patient-submitted analysis files to (bot must be admin there).
STORAGE_CHAT_ID=
ANALYSIS_TMP_DIR=./tmp/analysis

CORS_ORIGINS=["http://localhost:5173"]
