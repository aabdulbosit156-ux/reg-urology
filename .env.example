# ─── Majburiy ───────────────────────────────────────────────────────────────
# Yagona maxfiy kalit. SESSION_SECRET, APP_ENCRYPTION_KEY va WEBHOOK_SECRET shu
# tokendan avtomatik (deterministik) hosil qilinadi. Kamida 32 baytli tasodifiy
# qiymat bo'lsin. Yaratish: `openssl rand -hex 32`
ADMIN_TOKEN=replace-with-at-least-32-random-bytes

# Ma'lumotlar bazasi. Railway'da Postgres qo'shsangiz avtomatik beriladi
# (${{Postgres.DATABASE_URL}} reference). Lokalda:
DATABASE_URL=postgresql://regurolog:change-me@127.0.0.1:5432/regurolog

# ─── Ixtiyoriy ──────────────────────────────────────────────────────────────
# Jarayon rejimi: "all" (default) — bitta jarayon API + frontend + botni beradi.
# Alohida servislar kerak bo'lsa: "api" yoki "worker".
# REGUROLOG_PROCESS=all

# Ilovaning ommaviy https manzili — Telegram bot webhook va CORS uchun kerak.
# Railway'da servisning public domenidan avtomatik aniqlanadi (RAILWAY_PUBLIC_DOMAIN).
# PUBLIC_BASE_URL=https://sizning-domeningiz.up.railway.app

# Muhit. Railway aniqlansa avtomatik "production" bo'ladi. Lokalda:
REGUROLOG_ENV=development

# Frontend build papkasi (faqat lokal ishlatishda). Container'da /app/web.
# WEB_DIST_DIR=apps/web/dist

# ─── Ixtiyoriy sozlash (o'zgartirmasangiz ham bo'ladi) ──────────────────────
# COOKIE_SECURE / TRUST_PROXY_HEADERS hosted muhitda avtomatik true bo'ladi.
# ROOT_SESSION_TTL_SECONDS=3600
# STAFF_SESSION_TTL_SECONDS=28800
# STAFF_IDLE_TIMEOUT_SECONDS=1800
# LOGIN_CHALLENGE_TTL_SECONDS=120
# INVITE_TTL_SECONDS=86400
# BOOKING_HORIZON_DAYS=90
# NO_SHOW_GRACE_MINUTES=30
# WORKER_POLL_SECONDS=1
# INBOX_PAYLOAD_RETENTION_HOURS=24
