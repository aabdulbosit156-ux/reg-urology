# Lokal PostgreSQL yoki Railway Postgres reference variable
DATABASE_URL=postgresql://regurolog:change-me@127.0.0.1:5432/regurolog

REGUROLOG_ENV=development
ADMIN_TOKEN=replace-with-at-least-32-random-bytes
SESSION_SECRET=replace-with-an-independent-32-byte-secret
APP_ENCRYPTION_KEY=replace-with-an-independent-32-byte-encryption-secret
WEBHOOK_SECRET=replace-with-an-independent-32-byte-webhook-secret
PUBLIC_BASE_URL=http://127.0.0.1:4173
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
ROOT_SESSION_TTL_SECONDS=3600
STAFF_SESSION_TTL_SECONDS=28800
STAFF_IDLE_TIMEOUT_SECONDS=1800
LOGIN_CHALLENGE_TTL_SECONDS=120
INVITE_TTL_SECONDS=86400
BOOKING_HORIZON_DAYS=90
NO_SHOW_GRACE_MINUTES=30
WORKER_POLL_SECONDS=1
INBOX_PAYLOAD_RETENTION_HOURS=24
